PORT=8080
SDK_JWT_SECRET=replace_with_strong_secret
ADMIN_API_KEY=replace_with_admin_api_key
DB_FILE=./data/sdk-db.json

# Google Play service account JSON string (preferred)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: path to service account file
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: comma-separated allowed package names for security
ALLOWED_ANDROID_PACKAGES=com.example.game
